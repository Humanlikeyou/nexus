<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Muse EEG over BLE (btleplug). Hardened runtime blocks Bluetooth without this. -->
  <key>com.apple.security.device.bluetooth</key>
  <true/>
  <!-- Deliberately absent: app-sandbox (not sandboxed), get-task-allow (debug only),
       cs.allow-jit (WKWebView's JIT runs in Apple's own WebContent process, not ours; no Rust
       code here maps writable+executable memory), disable-library-validation. -->
</dict>
</plist>
