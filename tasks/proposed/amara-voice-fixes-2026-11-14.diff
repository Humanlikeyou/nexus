 NO_REQUEST_RE = re.compile(r"^\W*(?:(?:hey|hi|hello|yes|yeah|um+|uh+|hmm+)\W*)*$", re.I)
 
 
+def app_alive(path=APP_ALIVE, now_ms=None, max_age_s=APP_ALIVE_MAX_AGE_S):
+    """True only while Amara OS is open: app_alive is a regular file we own (not a symlink, no group/other write),
+    its timestamp is fresh and its pid is a live process. Anything else fails closed (False)."""
+    try:
+        st = os.lstat(path)
+        if not stat.S_ISREG(st.st_mode) or st.st_uid != os.getuid() or st.st_mode & 0o022:
+            return False
+        pid_s, ms_s = Path(path).read_text().split()[:2]
+        pid, ms = int(pid_s), int(ms_s)
+        now_ms = time.time() * 1000 if now_ms is None else now_ms
+        if pid <= 0 or abs(now_ms - ms) > max_age_s * 1000:
+            return False
+        try:
+            os.kill(pid, 0)
+        except PermissionError:
+            pass  # exists, owned by someone else
+        return True
+    except (OSError, ValueError):
+        return False
+
