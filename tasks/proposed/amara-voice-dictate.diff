     return None
 
 
+def write_dictate_result(req_id, text):
+    """Text only (or ok=false), atomically. The audio never reaches this function or the disk."""
+    DICTATE_DIR.mkdir(mode=0o700, exist_ok=True)
+    tmp = DICTATE_DIR / "result.json.tmp"
+    tmp.write_text(json.dumps({"id": req_id, "ok": bool(text), "text": text}))
+    tmp.replace(DICTATE_DIR / "result.json")
+
+
+def run_dictation(ears, asr, out_dev, req, busy=False):
+    """One on-device dictation for Amara OS, on the mic stream the loop already owns: record once, transcribe with the
+    local Whisper (asr.py), answer with TEXT ONLY. The audio exists only in this function's memory and is dropped."""
+    text = ""
+    try:
+        if not busy:
+            ears.flush()
+            chime(out_dev, "wake")
+            ears.flush()  # the chime must not be the dictation
+            audio = ears.next_utterance(timeout_s=8, max_s=req["max_secs"])
+            if audio is not None:
+                try:
+                    tr = transcribe(asr, audio)
+                    if tr.verdict != "noise":
+                        text = " ".join(str(tr.text).split())[:DICTATE_MAX_CHARS]
+                finally:
+                    del audio  # dropped now; nothing is ever written to disk
+    except Exception as e:
+        print(f"  [dictation failed: {type(e).__name__}]", flush=True)
+        text = ""
+    finally:
+        DICTATE_REQ.clear()
+        DICTATE_PENDING.clear()
+    try:
+        write_dictate_result(req["id"], text)
+    except OSError:
+        pass
+
+
+def dictate_watcher(stop=None):
+    """Polls dictate/request.json (0.4 s), reads and deletes it. Fails closed: only a fresh request with a known
+    purpose ("add" or "checkin") is queued, one at a time; the recording itself happens in the main loop."""
+    req = DICTATE_DIR / "request.json"
+    while not (stop and stop.is_set()):
+        time.sleep(0.4)
+        try:
+            raw = req.read_text()
+            req.unlink()
+        except OSError:
+            continue
+        try:
+            d = json.loads(raw)
+            fresh = abs(time.time() * 1000 - float(d["ts"])) <= DICTATE_MAX_AGE_S * 1000
+            if not (fresh and d["purpose"] in ("add", "checkin") and not DICTATE_PENDING.is_set()):
+                continue
+            DICTATE_REQ.update(id=str(d["id"])[:40], max_secs=max(3, min(30, int(d["max_secs"]))))
+        except Exception:
+            continue
+        DICTATE_PENDING.set()
+
+
+def start_dictation():
+    import atexit  # local: the speak patch also adds a top-level import atexit
+
+    DICTATE_DIR.mkdir(mode=0o700, exist_ok=True)
+    for f in ("request.json", "result.json", "result.json.tmp"):
+        (DICTATE_DIR / f).unlink(missing_ok=True)
+    DICTATE_READY.write_text(f"{os.getpid()}\n")
+    atexit.register(lambda: DICTATE_READY.unlink(missing_ok=True))  # Amara OS sees "not ready" once she stops
+    threading.Thread(target=dictate_watcher, daemon=True).start()
+
+
 def main():
