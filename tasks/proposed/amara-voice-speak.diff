+def speak_watcher(say, audio_lock, stop=None):
+    """Speak lines Amara OS asks for (navy mode, opened by voice). Local Ming voice only, no network.
+    Fails closed: speaks only while the navy flag file says "1", only a fresh request.json of <= SPEAK_MAX_CHARS
+    characters, then deletes it. Anything malformed is dropped silently."""
+    SPEAK_DIR.mkdir(mode=0o700, exist_ok=True)
+    SPEAK_READY.write_text(f"{os.getpid()}\n")
+    req = SPEAK_DIR / "request.json"
+    while not (stop and stop.is_set()):
+        time.sleep(0.4)
+        try:
+            raw = req.read_text()
+            req.unlink()
+        except OSError:
+            continue
+        try:
+            d = json.loads(raw)
+            text = " ".join(str(d["text"]).split())[:SPEAK_MAX_CHARS]
+            fresh = abs(time.time() * 1000 - float(d["ts"])) <= SPEAK_MAX_AGE_S * 1000
+            navy_on = NAVY_FLAG.read_text().strip() == "1"
+        except Exception:
+            continue
+        if not (text and fresh and navy_on):
+            continue
+        try:
+            with audio_lock:  # never over a timer, alarm or her own reply
+                say(text)
+        except Exception as e:
+            print(f"  [speak request failed: {type(e).__name__}]", flush=True)
 
 
