+class TokenGateTest(unittest.TestCase):
+    """AMARA_VOICE_REQUIRE_LAUNCH_TOKEN: missing/wrong token or any Origin is refused."""
+    GOOD = "0123456789abcdef" * 4
+
+    @classmethod
+    def setUpClass(cls):
+        cls.port = level_feed.start(port=0) or level_feed._port
+
+    def setUp(self):
+        import tempfile
+        self.dir = tempfile.mkdtemp()
+        self.path = os.path.join(self.dir, "launch_token")
+        self.saved = (level_feed.REQUIRE_TOKEN, level_feed.TOKEN_PATH)
+        level_feed.REQUIRE_TOKEN, level_feed.TOKEN_PATH = True, self.path
+        level_feed._token_cache = (None, None)
+
+    def tearDown(self):
+        level_feed.REQUIRE_TOKEN, level_feed.TOKEN_PATH = self.saved
+        level_feed._token_cache = (None, None)
+
+    def write(self, t):
+        with open(self.path, "w") as f:
+            f.write(t + "\n")
+
+    def status(self, **over):
+        s, data = connect(self.port, req(self.port, **over))
+        s.close()
+        return data.split(b"\r\n", 1)[0], data
+
+    def test_default_is_off(self):
+        self.assertFalse(self.saved[0])
+
+    def test_good_token_connects_and_is_echoed(self):
+        self.write(self.GOOD)
+        line, data = self.status(**{"Sec-WebSocket-Protocol": "amara-launch." + self.GOOD})
+        self.assertIn(b"101", line)
+        self.assertIn(("Sec-WebSocket-Protocol: amara-launch." + self.GOOD).encode(), data)
+
+    def test_missing_wrong_or_no_file_refused(self):
+        self.write(self.GOOD)
+        self.assertIn(b"403", self.status()[0])
+        self.assertIn(b"403", self.status(**{"Sec-WebSocket-Protocol": "amara-launch." + "f" * 64})[0])
+        self.assertIn(b"403", self.status(**{"Sec-WebSocket-Protocol": "other"})[0])
+        os.remove(self.path)
+        level_feed._token_cache = (None, None)
+        self.assertIn(b"403", self.status(**{"Sec-WebSocket-Protocol": "amara-launch." + self.GOOD})[0])
+
+    def test_origin_refused_even_with_good_token(self):
+        self.write(self.GOOD)
+        line, _ = self.status(Origin="http://evil.example",
+                              **{"Sec-WebSocket-Protocol": "amara-launch." + self.GOOD})
+        self.assertIn(b"403", line)
+
+    def test_rotation_is_picked_up(self):
+        self.write(self.GOOD)
+        self.assertIn(b"101", self.status(**{"Sec-WebSocket-Protocol": "amara-launch." + self.GOOD})[0])
+        new = "f" * 64
+        time.sleep(0.01)
+        self.write(new)
+        os.utime(self.path, ns=(time.time_ns(), time.time_ns() + 5_000_000))
+        self.assertIn(b"403", self.status(**{"Sec-WebSocket-Protocol": "amara-launch." + self.GOOD})[0])
+        self.assertIn(b"101", self.status(**{"Sec-WebSocket-Protocol": "amara-launch." + new})[0])
+
