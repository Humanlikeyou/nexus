+def _read_token():
+    """The current launch token (64 lowercase hex) or None. Re-read when the file's mtime changes."""
+    global _token_cache
+    try:
+        m = os.stat(TOKEN_PATH).st_mtime_ns
+        if _token_cache[0] == m:
+            return _token_cache[1]
+        with open(TOKEN_PATH, "r", encoding="ascii") as f:
+            t = f.read(256).strip()
+        ok = len(t) == 64 and all(c in "0123456789abcdef" for c in t)
+        _token_cache = (m, t if ok else None)
+        return _token_cache[1]
+    except Exception:
+        _token_cache = (None, None)
+        return None
+
+
+def _offered_protocol(h):
+    """The first offered subprotocol that starts with the token prefix, else None."""
+    for p in h.get("sec-websocket-protocol", "").split(","):
+        p = p.strip()
+        if p.startswith(TOKEN_PREFIX):
+            return p
+    return None
+
+
+def _token_ok(offered):
+    want = _read_token()  # missing/malformed file: fail closed
+    if want is None or offered is None:
+        return False
+    return hmac.compare_digest(offered[len(TOKEN_PREFIX):].encode("latin-1", "replace"), want.encode())
+
