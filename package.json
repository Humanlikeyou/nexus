{
  "name": "nexus",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test:neuro": "node --experimental-strip-types --test src-console/neuro/*.test.mjs",
    "bundle:local": "APPLE_SIGNING_IDENTITY=- tauri build",
    "preview": "vite preview",
    "tauri": "tauri",
    "mock-gateway": "node scripts/mock-gateway.mjs",
    "mock-gateway:partial": "node scripts/mock-gateway.mjs --partial",
    "mock-gateway:no-ack": "node scripts/mock-gateway.mjs --no-ack",
    "mock-gateway:fail": "node scripts/mock-gateway.mjs --fail",
    "outbox-status": "bash scripts/outbox-status.sh",
    "test:unit": "TZ=Asia/Tokyo vitest run",
    "test:e2e": "node scripts/e2e.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "test": "npm run check:secrets && tsc --noEmit && npm run test:unit && npm run test:neuro && cargo test --manifest-path src-tauri/Cargo.toml",
    "lint": "eslint src-console"
  },
  "dependencies": {
    "@tauri-apps/api": "~2.11.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@tauri-apps/cli": "~2.11.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "8.72.1",
    "vite": "^6.0.0",
    "vitest": "^4.1.12"
  }
}
