# Terrance Stack — Environment Variables
# Copy to .env (or run ./setup.sh to auto-generate secrets).
# DO NOT commit .env.

# PostgreSQL
POSTGRES_USER=terrance
POSTGRES_PASSWORD=GENERATE_WITH_SETUP_SH

# n8n credential encryption key (must be 32 chars)
N8N_ENCRYPTION_KEY=GENERATE_WITH_SETUP_SH

# Timezone
TIMEZONE=America/Los_Angeles

# LLM API Keys — leave blank to use Ollama only
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Ollama (local, running on host Mac outside Docker)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma4:latest
OLLAMA_EMBED_MODEL=nomic-embed-text

# Stage 3 Gateway — Service URLs (host-facing, for scripts and smoke tests)
# n8n and its Code nodes use the Docker-internal names (letta:8283, verba:8000, weaviate:8080)
# These host-facing URLs are for scripts running outside Docker.
N8N_URL=http://localhost:5678
LETTA_URL=http://localhost:8283
VERBA_URL=http://localhost:8001
WEAVIATE_URL=http://localhost:8080

# Stage 5E — crew-service (CrewAI). Token is shared with the Nexus app (crew.rs):
# export the same CREW_SERVICE_TOKEN (and optionally CREW_SERVICE_URL) where Nexus runs.
CREW_SERVICE_TOKEN=change-me-long-random-string
CREW_SERVICE_URL=http://127.0.0.1:8400
CREW_MAX_TASK_CHARS=4000
CREW_MAX_CONCURRENT=1
CREW_RUN_TIMEOUT_SECONDS=900
CREW_ALLOWED_NAMES=
# LLM — crews call the Amara Router only (tier by alias amara-fast / amara-deep + X-Amara-Route).
# OLLAMA_BASE_URL above is still used by other services, no longer by crew-service.
CREW_ROUTER_URL=http://host.docker.internal:8787/v1
# Optional bearer, only if the router's cloud tier ever demands one. Blank today.
CREW_ROUTER_KEY=
# The crew service has no cloud path (MiniMax was removed). Crews wait while the deep model is
# resident (a deep chat turn), up to this many seconds; 0 turns the wait off.
CREW_DEEP_WAIT_MAX_SECONDS=300

# Stage 4 gateway — shared secret checked by the n8n ingress workflow (X-Nexus-Secret header).
# Empty = every ingress request is rejected (fail closed).
NEXUS_SECRET=change-me-long-random-string

# Letta — password-protect the REST API (SECURE=true is set in docker-compose.yml)
SECURE=true
LETTA_SERVER_PASSWORD=change-me-long-random-string

# Letta's own Postgres login (limited to letta_db). Apply with: ./scripts/postgres_letta_role.sh
LETTA_DB_USER=letta_app
LETTA_DB_PASSWORD=change-me-long-random-string
