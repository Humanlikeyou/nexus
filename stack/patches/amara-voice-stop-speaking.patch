+def stop_speaking(*_):
+    """Interrupt the reply being played now (same cut-off as a barge-in 'stop'). No-op when she is silent.
+    Safe in a signal handler: only sets Events."""
+    EXT_STOP.set()
+    if (p := _ACTIVE_PLAYER) is not None:
+        p.stop.set()
